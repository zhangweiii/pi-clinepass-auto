{
  "name": "pi-clinepass-auto",
  "version": "0.1.1-beta.0",
  "description": "ClinePass provider for pi with a live model catalog, a server-truth usage meter, and web search / page fetching on the same Cline account",
  "type": "module",
  "license": "MIT",
  "author": "zhangweiii <zhangwei.ink@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangweiii/pi-clinepass-auto.git"
  },
  "homepage": "https://github.com/zhangweiii/pi-clinepass-auto#readme",
  "bugs": {
    "url": "https://github.com/zhangweiii/pi-clinepass-auto/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "cline",
    "clinepass",
    "coding-agent",
    "provider",
    "web-search"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "generate-seed": "node scripts/generate-seed.ts",
    "prepublishOnly": "npm run typecheck && npm test",
    "release:beta": "npm version prerelease --preid=beta && git push --follow-tags",
    "release:stable": "npm version patch && git push --follow-tags"
  }
}
